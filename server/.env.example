PORT=5000

# Conexión a Base de Datos Remota (Supabase PostgreSQL)
# Local (Session Pooler IPv4, puerto 5432) o Vercel Serverless (Transaction Pooler IPv4, puerto 6543)
#DATABASE_URL=postgresql://nexpos_app.[PROJECT_REF]:[TU_PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres
#DATABASE_SSL=true

# Supabase Auth (verificación de sesiones Google OAuth / correo)
#SUPABASE_URL=https://[PROJECT_REF].supabase.co
#SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Conexión local alternativa con PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=tienda_tecnologia

# Configuración opcional de correo SMTP
#PUBLIC_URL=https://tu-app-en-vercel.app
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=tu_correo@gmail.com
#SMTP_PASS=tu_app_password
#SMTP_FROM="NexPOS Suite <no-reply@nexpos.local>"
